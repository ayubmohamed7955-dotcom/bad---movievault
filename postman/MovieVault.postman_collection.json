        },
        {
          "name": "POST create movie",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 Created\", () => pm.response.to.have.status(201));",
                  "",
                  "const movie = pm.response.json();",
                  "const sent = JSON.parse(pm.request.body.raw);",
                  "",
                  "pm.test(\"Response contains the new movieId\", () => {",
                  "    pm.expect(movie.movieId).to.be.a(\"number\").above(0);",
                  "});",
                  "",
                  "pm.test(\"Returned values match the request\", () => {",
                  "    pm.expect(movie.title).to.eql(sent.title);",
                  "    pm.expect(movie.runtimeMinutes).to.eql(sent.runtimeMinutes);",
                  "    pm.expect(movie.status).to.eql(sent.status);",
                  "    pm.expect(movie.directorId).to.eql(sent.directorId);",
                  "});",
                  "",
                  "pm.test(\"Location header points to the new movie\", () => {",
                  "    pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/api/movies/\" + movie.movieId);",
                  "});",
                  "",
                  "// Bruges af de næste requests",
                  "pm.environment.set(\"createdMovieId\", movie.movieId);"
                ]
