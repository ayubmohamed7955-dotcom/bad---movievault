    {
      "name": "6. Role-based movie access",
      "description": "Same endpoint, different results for Admin and Actor.",
      "item": [
        {
          "name": "Admin GET /api/movies returns all movies",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const ids = pm.response.json().map(m => m.movieId);",
                  "",
                  "// Alle seedede film (1-6), også dem actor.demo IKKE medvirker i (2, 4, 6)",
                  "pm.test(\"Contains all seeded movies 1-6\", () => {",
                  "    [1, 2, 3, 4, 5, 6].forEach(id => pm.expect(ids).to.include(id));",
                  "});",
                  "",
                  "// Gemmes, så Actor-testen kan sammenligne med den fulde liste",
                  "pm.environment.set(\"adminMovieCount\", ids.length);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/movies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "movies"
              ]
            },
            "description": "Admin always has access to all movies.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Actor GET /api/movies returns only own movies",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const ids = pm.response.json().map(m => m.movieId).sort((a, b) => a - b);",
                  "",
                  "// actor.demo = Mikkel Strand (ActorId 1), som medvirker i film 1, 3 og 5 (seed data)",
                  "pm.test(\"Returns exactly the actor's movies 1, 3 and 5\", () => {",
                  "    pm.expect(ids).to.eql([1, 3, 5]);",
                  "});",
                  "",
                  "pm.test(\"Does not include movies the actor is not in (2, 4, 6)\", () => {",
                  "    [2, 4, 6].forEach(id => pm.expect(ids).to.not.include(id));",
                  "});",
                  "",
