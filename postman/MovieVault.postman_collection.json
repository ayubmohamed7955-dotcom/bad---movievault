{
  "info": {
    "name": "MovieVault - Movie controller",
    "description": "Tests for the Movie controller: CRUD, authentication (401), authorization (403) and role-dependent results.\n\nRun the whole collection in order with the Collection Runner. Folders and requests depend on each other through environment variables (adminToken, actorToken, createdMovieId, adminMovieCount).\n\nRequires the seeded demo users and seed data. Fill in adminPassword and actorPassword in your local environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{adminToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Login",
      "description": "Gets tokens for Admin and Actor. Must run first.",
      "item": [
        {
          "name": "Login as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"Response contains a token\", () => {",
                  "    pm.expect(body.token).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "",
                  "pm.test(\"User has the Admin role\", () => {",
                  "    pm.expect(body.roles).to.include(\"Admin\");",
                  "});",
                  "",
                  "// Gem tokenet til de næste requests",
                  "pm.environment.set(\"adminToken\", body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Logs in as the seeded Admin demo user and stores the JWT in adminToken.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login as Actor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"Response contains a token\", () => {",
                  "    pm.expect(body.token).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "",
                  "pm.test(\"User has the Actor role\", () => {",
                  "    pm.expect(body.roles).to.include(\"Actor\");",
                  "});",
                  "",
                  "pm.environment.set(\"actorToken\", body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Logs in as actor.demo, who is linked to Mikkel Strand (ActorId 1). Stores the JWT in actorToken.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"{{actorUsername}}\",\n  \"password\": \"{{actorPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
