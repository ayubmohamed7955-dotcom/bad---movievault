                  "pm.test(\"Returns movie 1 'The Last Lighthouse'\", () => {",
                  "    pm.expect(movie.movieId).to.eql(1);",
                  "    pm.expect(movie.title).to.eql(\"The Last Lighthouse\");",
                  "});",
                  "",
                  "pm.test(\"Details include cast and filming locations\", () => {",
                  "    pm.expect(movie.cast).to.be.an(\"array\").that.is.not.empty;",
                  "    pm.expect(movie.filmingLocations).to.be.an(\"array\");",
