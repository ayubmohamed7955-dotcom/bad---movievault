# Kopiér denne fil til .env og udfyld værdierne. .env må ALDRIG committes.
# Undgå tegnene $ ; og " i værdierne (de giver problemer i Compose og connection strings).

# SQL Server (min. 8 tegn med store/små bogstaver, tal og symbol)
SA_PASSWORD=<sql-server-sa-password>

# JWT - nøglen skal være Base64 og mindst 32 bytes.
# Generér i PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
JWT_KEY=<base64-signing-key>
JWT_ISSUER=MovieVault
JWT_AUDIENCE=MovieVaultClients
JWT_EXPIRY_MINUTES=60

# Demo-konti (actor.demo, director.demo, reviewer.demo, admin.demo)
DEMO_ACTOR_PASSWORD=<actor-password>
DEMO_DIRECTOR_PASSWORD=<director-password>
DEMO_REVIEWER_PASSWORD=<reviewer-password>
DEMO_ADMIN_PASSWORD=<admin-password>

# Service-konto til simulatoren (får Admin-rollen)
SERVICE_ACCOUNT_USERNAME=simulator.service
SERVICE_ACCOUNT_PASSWORD=<service-account-password>

# Simulator
SIMULATOR_INTERVAL_SECONDS=15
