{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=MovieVaultDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.MongoDB", "Serilog.Expressions" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "Filter": [
              {
                "Name": "ByIncludingOnly",
                "Args": {
                  "expression": "SourceContext = 'MovieVault.Api.Middleware.ChangeLoggingMiddleware'"
                }
              }
            ],
            "WriteTo": [
              {
                "Name": "MongoDBBson",
                "Args": {
                  "databaseUrl": "mongodb://localhost:27017/MovieVaultLogs",
                  "collectionName": "RequestLogs"
                }
              }
            ]
          }
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
